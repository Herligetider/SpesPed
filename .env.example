# Copy into a private .env and replace placeholders; never commit populated values.
SPESPED_ENVIRONMENT=production
SPESPED_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DB_HOST/REPLACE_DB_NAME
SPESPED_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SPESPED_ALLOWED_ORIGINS=["https://REPLACE_WITH_PRIVATE_SCHOOL_HOST"]
SPESPED_COOKIE_SECURE=true
SPESPED_SESSION_HOURS=8

# Optional local evidence processing. Unconfigured storage/scanning is visibly
# unavailable; no synthetic scanner or remote fallback is enabled in production.
# SPESPED_EVIDENCE_STORAGE_ROOT=/var/lib/spesped/private-evidence
# SPESPED_EVIDENCE_CLAMD_SOCKET=/run/clamav/clamd.sock
# SPESPED_EVIDENCE_OCR_ENABLED=true
# SPESPED_EVIDENCE_TESSERACT=/usr/bin/tesseract
# SPESPED_EVIDENCE_PDFTOPPM=/usr/bin/pdftoppm
# SPESPED_EVIDENCE_OCR_LANGUAGE=nor+eng
# SPESPED_EVIDENCE_TESSDATA_DIR=/usr/share/tesseract-ocr/tessdata

# Explicit operator configuration, never supplied by a browser or uploaded source.
# Use the actual private model endpoint and its supported capabilities.
SPESPED_AI_PROVIDERS=[]
SPESPED_AI_PRIVATE_NETWORKS=["127.0.0.0/8","::1/128"]
SPESPED_AI_REMOTE_SYNTHETIC_DEVELOPMENT=false
# SPESPED_AI_EVALUATION_SUITES=/etc/spesped/synthetic-evaluations/suites.json
# Development only; trusted synthetic fixture loader attestations, never pupil data:
# SPESPED_AI_SYNTHETIC_MANIFEST=/private/development/synthetic-source-manifest.json
